[TEMPLATE]
# ============================================================
# Pulse AI — Environment Variables
# ============================================================

# Server
NODE_ENV=development
PORT=8000
HOST=localhost

# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/pulsedb?sslmode=require

# Frontend URL
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# JWT (legacy — can remove if using Firebase only)
JWT_SECRET=change-this-to-a-long-random-string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Firebase Admin SDK
# Get from: Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_PROJECT_ID=pulse-ai-9cace
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@pulse-ai-9cace.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nxxxxx\n-----END PRIVATE KEY-----\n"

# Admin
# Used to protect admin endpoints and the /admin dashboard.
# Generate a long random string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET_KEY=change-this-to-a-long-random-string

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# OpenRouter AI
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_PRIMARY_MODEL=deepseek/deepseek-chat-v3-0324:free
OPENROUTER_FALLBACK_MODELS=google/gemma-2-9b-it:free,mistralai/mistral-7b-instruct:free
